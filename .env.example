# Copy to .env for local runs. On Render, set these in the dashboard.

APP_NAME=Stock Scanner
# your public URL on Render, e.g. https://scanner.onrender.com
BASE_URL=http://127.0.0.1:8000

# Sessions + encryption of broker secrets (required with Firestore)
# python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Super admin (seeded into Firestore on every start; env is the source of truth)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

# Storage: firestore (default) or memory (local dev only)
STORAGE=firestore
# local
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Render: paste the whole service-account JSON
# FIREBASE_CREDENTIALS_JSON={...}
COLLECTION_PREFIX=ssa_
# Reads are cached in memory; the app's own writes refresh it instantly.
# This only delays edits made directly in the Firebase console.
CACHE_TTL_SECONDS=300

SCANNER_ENABLED=1
# Nifty OI snapshots (open, then every 15/30 min) ride on the scanner; 0 turns them off
OI_CAPTURE=1

# Keep the free Render instance awake by pinging itself every KEEP_ALIVE_SECONDS.
# Render sets RENDER_EXTERNAL_URL automatically; set this only to override it.
KEEP_ALIVE_URL=
KEEP_ALIVE_SECONDS=300

# Email sender. Telegram and WhatsApp are set up by each user in the app.
# Preferred: Brevo (free 300 emails/day). EMAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Stock Scanner
# Fallback when BREVO_API_KEY is empty: Gmail SMTP with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Gmail address
SMTP_USER=
# Gmail app password (Google account → Security → App passwords)
SMTP_PASSWORD=
SMTP_FROM=
